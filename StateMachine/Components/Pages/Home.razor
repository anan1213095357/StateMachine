<script>
    (() => {
        const WORLD_WIDTH = 4000;
        const WORLD_HEIGHT = 2500;
        const MIN_ZOOM = 0.25;
        const MAX_ZOOM = 1.8;

        let dotnet = null;
        let workspace = null;
        let world = null;
        let scaleBox = null;
        let edgeLayer = null;
        let tempEdge = null;
        let canvasZoom = 0.85;
        let edgeState = { edges: [], selectedEdgeId: null, runningEdgeIds: [], pending: null };
        let drag = null;
        let pan = null;
        let suppressClickUntil = 0;
        let initialized = false;

        const clampZoom = value => Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, value));

        function getPortPosition(stateId, portId) {
            const element = document.querySelector(`.port[data-state-id="${CSS.escape(stateId)}"][data-port-id="${CSS.escape(portId)}"]`);
            if (!element || !world) return null;
            const rect = element.getBoundingClientRect();
            const worldRect = world.getBoundingClientRect();
            return {
                x: (rect.left - worldRect.left + rect.width / 2) / canvasZoom,
                y: (rect.top - worldRect.top + rect.height / 2) / canvasZoom
            };
        }

        function bezierPath(x1, y1, x2, y2) {
            const distance = Math.max(90, Math.abs(x2 - x1) * 0.45);
            return `M ${x1} ${y1} C ${x1 + distance} ${y1}, ${x2 - distance} ${y2}, ${x2} ${y2}`;
        }

        function drawEdges() {
            if (!edgeLayer) return;
            let html = "";
            const running = new Set(edgeState.runningEdgeIds || []);
            for (const edge of edgeState.edges || []) {
                const start = getPortPosition(edge.fromStateId, edge.fromPortId);
                const end = getPortPosition(edge.toStateId, edge.toPortId);
                if (!start || !end) continue;
                const d = bezierPath(start.x, start.y, end.x, end.y);
                let cls = "edge";
                if (edgeState.selectedEdgeId === edge.id) cls += " selected";
                if (running.has(edge.id)) cls += " running";
                    let stroke = "#64738a";
    let strokeWidth = 2;
    let filter = "";

    if (edgeState.selectedEdgeId === edge.id) {
        stroke = "#4c8dff";
        strokeWidth = 3;
    }

    if (running.has(edge.id)) {
        stroke = "#2bd59a";
        strokeWidth = 3;
        filter = "filter:drop-shadow(0 0 5px rgba(43,213,154,.8));";
    }

    html += `
    <path
        class="${cls}"
        d="${d}"
        fill="none"
        stroke="${stroke}"
        stroke-width="${strokeWidth}"
        style="${filter}">
    </path>`;

    html += `
    <path
        class="edge-hit"
        data-edge-id="${edge.id}"
        d="${d}"
        fill="none"
        stroke="transparent"
        stroke-width="16"
        style="pointer-events:stroke;cursor:pointer;">
    </path>`;
            }
            edgeLayer.innerHTML = html;
        }

        function updatePendingVisual() {
            document.querySelectorAll(".port.pending").forEach(x => x.classList.remove("pending"));
            if (!tempEdge) return;
            const pending = edgeState.pending;
            if (!pending) {
                tempEdge.style.display = "none";
                return;
            }
            const port = document.querySelector(`.port[data-state-id="${CSS.escape(pending.stateId)}"][data-port-id="${CSS.escape(pending.portId)}"]`);
            if (port) port.classList.add("pending");
            tempEdge.style.display = "block";
        }

        function updateTempEdge(clientX, clientY) {
            const pending = edgeState.pending;
            if (!pending || !tempEdge || !world) return;
            const start = getPortPosition(pending.stateId, pending.portId);
            if (!start) return;
            const rect = world.getBoundingClientRect();
            const x = (clientX - rect.left) / canvasZoom;
            const y = (clientY - rect.top) / canvasZoom;
            tempEdge.setAttribute("d", bezierPath(start.x, start.y, x, y));
        }

        function setZoom(value, keepCenter = false) {
            if (!workspace || !world || !scaleBox) return;
            const oldZoom = canvasZoom;
            let centerWorldX = 0;
            let centerWorldY = 0;
            if (keepCenter) {
                centerWorldX = (workspace.scrollLeft + workspace.clientWidth / 2) / oldZoom;
                centerWorldY = (workspace.scrollTop + workspace.clientHeight / 2) / oldZoom;
            }
            canvasZoom = clampZoom(Number(value));
            world.style.transform = `scale(${canvasZoom})`;
            scaleBox.style.width = `${WORLD_WIDTH * canvasZoom}px`;
            scaleBox.style.height = `${WORLD_HEIGHT * canvasZoom}px`;
            const label = document.getElementById("zoomLabel");
            if (label) label.textContent = `${Math.round(canvasZoom * 100)}%`;
            if (keepCenter) {
                workspace.scrollLeft = centerWorldX * canvasZoom - workspace.clientWidth / 2;
                workspace.scrollTop = centerWorldY * canvasZoom - workspace.clientHeight / 2;
            }
            requestAnimationFrame(drawEdges);
        }

        function fitCanvas() {
            if (!workspace) return;
            const cards = [...document.querySelectorAll(".state-card")];
            if (cards.length === 0) {
                setZoom(0.85, false);
                workspace.scrollLeft = 0;
                workspace.scrollTop = 0;
                return;
            }
            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            for (const card of cards) {
                const x = parseFloat(card.style.left) || 0;
                const y = parseFloat(card.style.top) || 0;
                const width = card.offsetWidth || 540;
                const height = card.offsetHeight || 220;
                minX = Math.min(minX, x);
                minY = Math.min(minY, y);
                maxX = Math.max(maxX, x + width);
                maxY = Math.max(maxY, y + height);
            }
            const padding = 120;
            const width = maxX - minX + padding * 2;
            const height = maxY - minY + padding * 2;
            const zoom = clampZoom(Math.min(workspace.clientWidth / width, workspace.clientHeight / height, 1));
            setZoom(zoom, false);
            workspace.scrollLeft = Math.max(0, (minX - padding) * zoom);
            workspace.scrollTop = Math.max(0, (minY - padding) * zoom);
        }

        function isBackground(target) {
            return target === workspace || target?.id === "world" || target?.id === "stateLayer" || target?.id === "edgeSvg";
        }

        function onPointerDown(event) {
            if (!workspace) return;
            const header = event.target.closest?.(".state-header");
            if (header && event.button === 0) {
                const card = header.closest(".state-card");
                if (!card) return;
                drag = {
                    stateId: card.dataset.stateId,
                    card,
                    mouseX: event.clientX,
                    mouseY: event.clientY,
                    startX: parseFloat(card.style.left) || 0,
                    startY: parseFloat(card.style.top) || 0,
                    x: parseFloat(card.style.left) || 0,
                    y: parseFloat(card.style.top) || 0,
                    moved: false
                };
                event.preventDefault();
                return;
            }

            if (event.button === 1 || (event.button === 0 && isBackground(event.target))) {
                pan = {
                    mouseX: event.clientX,
                    mouseY: event.clientY,
                    scrollLeft: workspace.scrollLeft,
                    scrollTop: workspace.scrollTop,
                    moved: false
                };
                workspace.style.cursor = "grabbing";
                event.preventDefault();
            }
        }

        function onPointerMove(event) {
            if (pan && workspace) {
                const dx = event.clientX - pan.mouseX;
                const dy = event.clientY - pan.mouseY;
                if (Math.abs(dx) + Math.abs(dy) > 3) pan.moved = true;
                workspace.scrollLeft = pan.scrollLeft - dx;
                workspace.scrollTop = pan.scrollTop - dy;
            }
            if (drag) {
                const dx = (event.clientX - drag.mouseX) / canvasZoom;
                const dy = (event.clientY - drag.mouseY) / canvasZoom;
                drag.x = Math.max(0, drag.startX + dx);
                drag.y = Math.max(0, drag.startY + dy);
                if (Math.abs(dx) + Math.abs(dy) > 1) drag.moved = true;
                if (drag.card?.isConnected) {
                    drag.card.style.left = `${drag.x}px`;
                    drag.card.style.top = `${drag.y}px`;
                }
                drawEdges();
            }
            updateTempEdge(event.clientX, event.clientY);
        }

        function onPointerUp() {
            if (pan) {
                if (pan.moved) suppressClickUntil = Date.now() + 150;
                pan = null;
                if (workspace) workspace.style.cursor = "";
            }
            if (drag) {
                const finished = drag;
                drag = null;
                if (finished.moved) {
                    suppressClickUntil = Date.now() + 150;
                    dotnet?.invokeMethodAsync("StateMoved", finished.stateId, finished.x, finished.y);
                }
            }
        }

        function onClick(event) {
            if (Date.now() < suppressClickUntil) return;
            const edge = event.target.closest?.(".edge-hit");
            if (edge?.dataset.edgeId) {
                event.stopPropagation();
                dotnet?.invokeMethodAsync("SelectEdgeFromJs", edge.dataset.edgeId);
                return;
            }
            if (event.target.closest?.(".port,.add-port,button,input,select,textarea,label")) return;
            const card = event.target.closest?.(".state-card");
            if (card?.dataset.stateId) {
                dotnet?.invokeMethodAsync("SelectStateFromJs", card.dataset.stateId);
                return;
            }
            if (isBackground(event.target)) dotnet?.invokeMethodAsync("ClearSelectionFromJs");
        }

        function onWheel(event) {
            if (!workspace || (!event.ctrlKey && !event.metaKey)) return;
            event.preventDefault();
            const rect = workspace.getBoundingClientRect();
            const mouseX = event.clientX - rect.left;
            const mouseY = event.clientY - rect.top;
            const worldX = (workspace.scrollLeft + mouseX) / canvasZoom;
            const worldY = (workspace.scrollTop + mouseY) / canvasZoom;
            const factor = event.deltaY < 0 ? 1.1 : 0.9;
            const newZoom = clampZoom(canvasZoom * factor);
            setZoom(newZoom, false);
            workspace.scrollLeft = worldX * newZoom - mouseX;
            workspace.scrollTop = worldY * newZoom - mouseY;
        }

        function onKeyDown(event) {
            const tag = document.activeElement?.tagName;
            if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
            if (event.key === "Delete") dotnet?.invokeMethodAsync("DeleteSelectionFromJs");
            if (event.key === "Escape") dotnet?.invokeMethodAsync("EscapeFromJs");
        }

        window.industrialStateMachineUi = {
            init(dotnetRef) {
                dotnet = dotnetRef;
                workspace = document.getElementById("workspace");
                world = document.getElementById("world");
                scaleBox = document.getElementById("worldScale");
                edgeLayer = document.getElementById("edgeLayer");
                tempEdge = document.getElementById("tempEdge");
                if (initialized) return;
                initialized = true;
                workspace?.addEventListener("pointerdown", onPointerDown);
                workspace?.addEventListener("click", onClick);
                workspace?.addEventListener("wheel", onWheel, { passive: false });
                workspace?.addEventListener("scroll", drawEdges);
                window.addEventListener("pointermove", onPointerMove);
                window.addEventListener("pointerup", onPointerUp);
                window.addEventListener("keydown", onKeyDown);
                window.addEventListener("resize", drawEdges);
            },
            dispose() {
                if (!initialized) return;
                workspace?.removeEventListener("pointerdown", onPointerDown);
                workspace?.removeEventListener("click", onClick);
                workspace?.removeEventListener("wheel", onWheel);
                workspace?.removeEventListener("scroll", drawEdges);
                window.removeEventListener("pointermove", onPointerMove);
                window.removeEventListener("pointerup", onPointerUp);
                window.removeEventListener("keydown", onKeyDown);
                window.removeEventListener("resize", drawEdges);
                initialized = false;
                dotnet = null;
            },
            sync(state) {
                edgeState = state || edgeState;
                updatePendingVisual();
                requestAnimationFrame(drawEdges);
            },
            setZoom(value, keepCenter) { setZoom(value, !!keepCenter); },
            adjustZoom(delta, keepCenter) { setZoom(canvasZoom + Number(delta), !!keepCenter); },
            fitCanvas,
            getAddStatePosition() {
                if (!workspace) return { x: 280, y: 140 };
                return {
                    x: (workspace.scrollLeft + 280) / canvasZoom,
                    y: (workspace.scrollTop + 140) / canvasZoom
                };
            },
            setInitialScroll(left, top) {
                if (!workspace) return;
                workspace.scrollLeft = Number(left) || 0;
                workspace.scrollTop = Number(top) || 0;
            },
            scrollConsoleToBottom() {
                const box = document.getElementById("console");
                if (box) box.scrollTop = box.scrollHeight;
            },
            downloadText(filename, text, mime) {
                const blob = new Blob([text], { type: mime || "text/plain" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = filename;
                a.click();
                URL.revokeObjectURL(url);
            },
            storage: {
                list(prefix) {
                    const keys = [];
                    for (let i = 0; i < localStorage.length; i++) {
                        const key = localStorage.key(i);
                        if (key && key.startsWith(prefix)) keys.push(key.substring(prefix.length));
                    }
                    return keys.sort((a, b) => a.localeCompare(b, "zh-CN"));
                },
                set(key, value) { localStorage.setItem(key, value); },
                get(key) { return localStorage.getItem(key); },
                remove(key) { localStorage.removeItem(key); }
            }
        };
    })();
</script>